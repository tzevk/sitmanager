{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/activity-log-weekly",
      "schedule": "45 21 * * 0"
    },
    {
      "path": "/api/cron/activity-log-cleanup",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/meta-leads-refresh",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/legacy-batch-sync",
      "schedule": "5-59/10 * * * *"
    },
    {
      "path": "/api/cron/suvidya-inquiry-sync",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sync-biometric-attendance",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/inquiry-followup-escalation",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/calendly-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/legacy-inquiry-import",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 60
    },
    "app/api/cron/**/*.ts": {
      "maxDuration": 300
    }
  }
}
